      "relevantPaths": ["packages/cli/src/commands/status/index.ts", "packages/read/src/index.ts", "packages/assemble-release-plan/src/index.ts", "packages/read/src/index.test.ts"],
      "knownUncertainty": ["runtime call order", "test coverage"],
      "expectedStop": { "classification": "continue_then_stop", "minimumFollowupReads": 1 }
