{
  "name": "fast-lane-app-server-poc",
  "displayName": "Vesper",
  "description": "Local-first coding-agent CLI and VS Code extension with Codex and optional API providers.",
  "version": "0.1.0",
  "publisher": "local-experiment",
  "bin": {
    "vesper": "./bin/vesper.js"
  },
  "files": [
    "*.js",
    "bin/vesper.js",
    "README.md",
    "INSTALL.md",
    "DEVELOPER-WORKFLOW.md",
    "PREVIEW-GUIDE.md",
    "PREVIEW-VALIDATION-CHECKLIST.md",
    "PREVIEW-FEEDBACK.md",
    "PROVIDER-LIVE-VALIDATION.md",
    "LICENSE",
    "LICENSE.*"
  ],
  "engines": {
    "node": ">=18",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:fastLane.openPanel"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node ./test/run-tests.js",
    "test:pty": "python3 ./test/pty-cli-smoke.py",
    "cli": "node ./bin/vesper.js",
    "package:vsix": "node ./scripts/package-vsix.js",
    "package:preview": "node ./scripts/package-preview.js",
    "evaluate:system-model": "node ./benchmark/run-system-model.js",
    "release:check": "node ./scripts/release-check.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "fastLane.openPanel",
        "title": "Vesper: Open Panel"
      }
    ]
  }
}
